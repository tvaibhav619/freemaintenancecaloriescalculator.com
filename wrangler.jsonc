{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freemaintenancecaloriescalculator",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "freemaintenancecaloriescalculator.com", "custom_domain": true },
    { "pattern": "www.freemaintenancecaloriescalculator.com", "custom_domain": true }
  ]
}
