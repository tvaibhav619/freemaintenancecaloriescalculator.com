---
import { languages, type SupportedLanguage } from '../i18n/ui';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../i18n/utils';

interface Props {
  className?: string;
  idPrefix?: string;
}

const { className = '', idPrefix = 'header' } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
const currentPath = Astro.url.pathname;

const btnId = `lang-menu-btn-${idPrefix}`;
const dropdownId = `lang-menu-dropdown-${idPrefix}`;
const arrowId = `lang-menu-arrow-${idPrefix}`;
const containerId = `lang-container-${idPrefix}`;
---

<div class={`relative inline-block text-left lang-picker-container ${className}`} id={containerId}>
  <button
    type="button"
    id={btnId}
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls={dropdownId}
    aria-label={t('lang.select')}
    class="lang-menu-btn h-8 sm:h-9 inline-flex items-center gap-1 sm:gap-2 px-1.5 sm:px-3 rounded-xl text-xs font-semibold border border-hairline bg-canvas text-ink hover:bg-canvas-elevated hover:border-ink/30 transition-all focus:outline-none focus:ring-1 focus:ring-ink flex-shrink-0 shadow-xs"
  >
    <!-- Globe Icon -->
    <svg class="w-3.5 h-3.5 text-mute flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-.778.099-1.533.284-2.253" />
    </svg>
    <span class="tracking-wide hidden sm:inline">{languages[currentLang]}</span>
    <span class="tracking-wide sm:hidden uppercase font-mono text-[11px]">{currentLang}</span>
    <!-- Chevron Down Icon -->
    <svg class="w-3 h-3 text-mute transition-transform duration-200 flex-shrink-0 lang-menu-arrow" id={arrowId} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown menu -->
  <div
    id={dropdownId}
    role="menu"
    aria-orientation="vertical"
    aria-labelledby={btnId}
    class="lang-menu-dropdown hidden absolute right-0 mt-1.5 w-40 max-w-[calc(100vw-1rem)] rounded-xl bg-canvas-elevated border border-hairline shadow-lg py-1.5 z-50 focus:outline-none backdrop-blur-md"
  >
    {
      Object.entries(languages).map(([langKey, label]) => {
        const isActive = langKey === currentLang;
        const targetUrl = translatePath(currentPath, langKey as SupportedLanguage);
        return (
          <a
            href={targetUrl}
            role="menuitem"
            class={`flex items-center justify-between px-3.5 py-1.5 text-xs font-medium transition-colors ${
              isActive
                ? 'bg-ink text-canvas font-semibold'
                : 'text-ink hover:bg-canvas-subtle'
            }`}
          >
            <span>{label}</span>
            <span class="text-[10px] uppercase font-mono text-mute opacity-80">{langKey}</span>
          </a>
        );
      })
    }
  </div>
</div>

<script>
  function initLangPickers() {
    const containers = document.querySelectorAll<HTMLElement>('.lang-picker-container');
    
    containers.forEach((container) => {
      const btn = container.querySelector<HTMLButtonElement>('.lang-menu-btn');
      const dropdown = container.querySelector<HTMLElement>('.lang-menu-dropdown');
      const arrow = container.querySelector<SVGElement>('.lang-menu-arrow');
      if (!btn || !dropdown) return;

      function toggle(show?: boolean) {
        const isVisible = show !== undefined ? show : dropdown?.classList.contains('hidden');
        if (isVisible) {
          dropdown?.classList.remove('hidden');
          btn?.setAttribute('aria-expanded', 'true');
          arrow?.classList.add('rotate-180');
        } else {
          dropdown?.classList.add('hidden');
          btn?.setAttribute('aria-expanded', 'false');
          arrow?.classList.remove('rotate-180');
        }
      }

      // Avoid double listener attachments
      if (btn.dataset.initialized === 'true') return;
      btn.dataset.initialized = 'true';

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggle();
      });

      document.addEventListener('click', (e) => {
        if (!container.contains(e.target as Node)) {
          toggle(false);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          toggle(false);
        }
      });
    });
  }

  initLangPickers();
  document.addEventListener('astro:page-load', initLangPickers);
</script>
