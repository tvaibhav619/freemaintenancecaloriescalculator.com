---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';

const seoTitle = "Maintenance Calorie Calculator | Most Accurate Daily Calorie Calculator";
const seoDescription = "Calculate your maintenance calories (TDEE), daily calorie burn, and customized macro targets. The most accurate maintenance calorie calculator and calorie calculator for weight loss.";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Maintenance Calorie Calculator",
  "url": "https://freemaintenancecaloriescalculator.com/",
  "description": "The most accurate maintenance calorie calculator and daily calorie calculator for weight loss, maintenance, and muscle gain.",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Mifflin-St Jeor equation calculation",
    "Katch-McArdle formula for lean body mass",
    "Revised Harris-Benedict baseline",
    "Calorie calculator for weight loss deficit planner",
    "Lean bulk surplus targets",
    "Interactive macronutrient distribution",
    "Meal frequency calorie & protein breakdown"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "what is my calorie maintenance calculator?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A calorie maintenance calculator is an evidence-based nutritional tool that determines your Total Daily Energy Expenditure (TDEE). It calculates the exact number of calories your body burns every 24 hours across resting organ function (BMR), non-exercise activity (NEAT), intentional workouts (EAT), and food digestion (TEF). Eating at this caloric target maintains your current body weight."
      }
    },
    {
      "@type": "Question",
      "name": "how accurate is maintenance calorie calculator?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When powered by clinical formulas like Mifflin-St Jeor, a maintenance calorie calculator is accurate within ±5% for the vast majority of healthy adults. When utilizing the Katch-McArdle formula with a known body fat percentage, precision increases further because it measures metabolically active Lean Body Mass rather than total weight."
      }
    },
    {
      "@type": "Question",
      "name": "which maintenance calorie calculator is best?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The best maintenance calorie calculator is one that provides transparent, clinically validated formulas (Mifflin-St Jeor for standard populations and Katch-McArdle for lean athletic individuals) rather than outdated 1919 Harris-Benedict formulas or arbitrary fitness tracker estimations. It should also calculate granular macronutrient splits and meal frequency distributions."
      }
    },
    {
      "@type": "Question",
      "name": "calorie maintenance calculator how to calculate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To calculate maintenance calories: First, compute your Basal Metabolic Rate (BMR) using Mifflin-St Jeor: [10 × weight in kg] + [6.25 × height in cm] - [5 × age] + s (+5 for men, -161 for women). Second, multiply your BMR by your physical activity multiplier (1.2 for sedentary up to 1.9 for extremely active). The resulting number is your daily maintenance calories."
      }
    },
    {
      "@type": "Question",
      "name": "How do I calculate what my maintenance calories should be?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can calculate your maintenance calories instantly using our free calculator above by entering your age, biological sex, height, current body weight, and daily activity level. Alternatively, you can use the 14-day empirical method: eat a consistent calorie target for two weeks while tracking morning weight; if your 7-day average remains stable, that caloric intake is your true maintenance level."
      }
    },
    {
      "@type": "Question",
      "name": "Is 1200 calories enough for maintenance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, for virtually all adults, 1200 calories is not enough for maintenance. A 1200-calorie diet is typically below the resting Basal Metabolic Rate (BMR) of adult humans, meaning it fails to provide adequate energy for basic cellular respiration, cardiac function, and liver metabolism. Sustaining 1200 calories long-term often causes metabolic adaptation, fatigue, and nutrient deficiencies."
      }
    },
    {
      "@type": "Question",
      "name": "Is 2000 calories a day maintenance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A 2000 calorie intake is a common national average used on nutrition facts labels, but individual maintenance varies widely. For an average sedentary to lightly active female, maintenance is typically 1,800 to 2,200 calories. For an active adult male, maintenance frequently ranges from 2,400 to 3,000+ calories depending on body weight, muscle mass, and step count."
      }
    },
    {
      "@type": "Question",
      "name": "What is the most accurate formula for maintenance calories?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Mifflin-St Jeor equation is clinically proven as the most accurate standard formula for general populations where body composition is unknown. For athletic or lean individuals who know their body fat percentage, the Katch-McArdle formula is even more accurate because it calculates energy expenditure directly from Lean Body Mass (LBM)."
      }
    },
    {
      "@type": "Question",
      "name": "What is a normal amount of maintenance calories?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Normal maintenance calories for adult women generally fall between 1,800 and 2,400 calories per day, and for adult men between 2,200 and 3,000 calories per day. Factors such as height, age, muscle mass, occupation, and daily step volume cause natural variations around these ranges."
      }
    },
    {
      "@type": "Question",
      "name": "Is it better to eat 1200 or 1500 calories a day?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For the vast majority of people aiming to lose weight, eating 1500 calories is vastly better than 1200 calories. A 1500-calorie target preserves lean muscle tissue, supports thyroid hormone output, provides essential micronutrients, and prevents the ravenous rebound binging associated with extreme 1200-calorie crash diets."
      }
    },
    {
      "@type": "Question",
      "name": "Is 1200 calories enough for a 5'5\" woman?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, 1200 calories is not enough for maintenance for a 5'5\" woman. An average 5'5\" woman weighing 135 to 150 lbs has a resting BMR of 1,350 to 1,450 calories and a maintenance TDEE between 1,800 and 2,200 calories. Consuming 1200 calories places her in an aggressive deficit that can cause hormonal disruption, hair thinning, and lethargy."
      }
    },
    {
      "@type": "Question",
      "name": "How long will it take to lose 20 pounds on a 1500 calorie diet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If your maintenance TDEE is 2,000 calories, consuming 1,500 calories creates a daily 500-calorie deficit (3,500 calories per week), which equals roughly 1 pound of fat loss per week. At this safe and sustainable rate, losing 20 pounds will take approximately 20 to 24 weeks (around 5 months)."
      }
    },
    {
      "@type": "Question",
      "name": "How much will you weigh if you eat 1500 calories a day?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If you consistently eat 1,500 calories a day, your body weight will gradually drop until 1,500 calories becomes your new biological maintenance expenditure. For an average sedentary adult female, 1,500 calories will eventually stabilize body weight at roughly 105 to 115 lbs, whereas for larger or active individuals it will continue downward until metabolic adaptation and mass loss equalize."
      }
    },
    {
      "@type": "Question",
      "name": "How many eggs are 1500 calories?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "One large whole egg contains approximately 72 calories and 6 grams of protein. Therefore, 1,500 calories equates to approximately 21 large whole eggs, providing roughly 126 grams of complete protein and 105 grams of dietary fats."
      }
    },
    {
      "@type": "Question",
      "name": "How many calories a day to lose 2 pounds a week?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To lose 2 pounds of fat per week, you need a daily caloric deficit of 1,000 calories below your maintenance TDEE (since 2 lbs of adipose tissue equates to ~7,000 calories). For example, if your maintenance is 2,600 calories, you must consume 1,600 calories per day. Note that daily deficits over 1,000 calories are aggressive and primarily suited for individuals with significant weight to lose."
      }
    },
    {
      "@type": "Question",
      "name": "How many calories do 10,000 steps burn 300 lbs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A person weighing 300 lbs (136 kg) burns approximately 700 to 900 calories walking 10,000 steps (about 4.5 to 5 miles). Because physical workload and energy expenditure are directly proportional to body mass moved against gravity, a 300 lb individual expends nearly double the calories of a 150 lb person completing the exact same distance."
      }
    },
    {
      "@type": "Question",
      "name": "Should I weigh food raw or cooked when tracking maintenance calories?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nutrition databases and food labels almost universally reference raw, uncooked food weights unless stated otherwise. Cooking fundamentally alters weight through moisture loss (meats shrink 20% to 30%, making them more calorie-dense) or water absorption (rice and pasta expand 2 to 3 times, diluting calorie density). If measuring cooked meals or meal prep, convert values using the Raw to Cooked Food Calculator (https://rawtocookedcalculator.com/) to maintain true caloric accuracy."
      }
    }
  ]
};
---

<Layout title={seoTitle} description={seoDescription}>
  <!-- JSON-LD Schemas for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION -->
  <section class="relative pt-16 pb-12 px-4 sm:px-6 overflow-hidden flex flex-col items-center text-center">
    <div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center gap-4">
      <!-- Technical Eyebrow Label -->
      <span class="inline-flex items-center justify-center gap-1.5 px-3 py-1 rounded-full bg-canvas-elevated border border-hairline text-[11px] sm:text-xs font-semibold text-ink shadow-xs max-w-full text-center" style="font-family: var(--font-mono);">
        <span class="w-2 h-2 rounded-full bg-emerald-500 flex-shrink-0"></span>
        <span class="truncate sm:whitespace-normal">Peer-Reviewed Metabolic Algorithms • 2026 Edition</span>
      </span>

      <!-- Primary H1 Display Title -->
      <h1 class="text-3xl xs:text-4xl sm:text-6xl font-extrabold text-ink tracking-tight leading-[1.1] break-words" style="letter-spacing: -1.5px;">
        Maintenance Calorie Calculator
      </h1>

      <!-- Subtitle with Secondary Keywords -->
      <p class="text-base sm:text-lg text-body max-w-2xl mx-auto leading-relaxed">
        The most accurate daily calorie calculator for weight loss, maintenance, and muscle gain. Calculate your true Total Daily Energy Expenditure (TDEE) and optimal macros with validated scientific formulas.
      </p>

      <!-- Trust Badges -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2 text-xs text-mute" style="font-family: var(--font-mono);">
        <span class="flex items-center gap-1.5">✓ Mifflin-St Jeor</span>
        <span class="flex items-center gap-1.5">✓ Katch-McArdle</span>
        <span class="flex items-center gap-1.5">✓ Harris-Benedict</span>
        <span class="flex items-center gap-1.5">✓ 100% Free & No Signup</span>
      </div>
    </div>
  </section>

  <!-- CALCULATOR SECTION -->
  <section id="calculator" class="px-4 sm:px-6 py-6 z-10 relative">
    <Calculator lang="en" />
  </section>

  <!-- THE 4 PILLARS OF ENERGY EXPENDITURE -->
  <section id="science" class="max-w-6xl mx-auto px-4 sm:px-6 py-20 border-t border-hairline mt-12">
    <div class="max-w-3xl mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-mute" style="font-family: var(--font-mono);">Energy Science</span>
      <h2 class="text-3xl font-bold text-ink tracking-tight mt-1 mb-3">The 4 Components of Total Daily Energy Expenditure (TDEE)</h2>
      <p class="text-body text-sm leading-relaxed">
        Your body does not burn energy in a single uniform way. Every calorie burned throughout the day originates from one of four distinct metabolic compartments:
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- BMR Card -->
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-sm" style="font-family: var(--font-mono);">01</span>
            <span class="text-xs font-bold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/50 px-2 py-0.5 rounded" style="font-family: var(--font-mono);">60 - 70%</span>
          </div>
          <h3 class="text-base font-bold text-ink mb-1.5">Basal Metabolic Rate (BMR)</h3>
          <p class="text-xs text-body leading-relaxed">
            The resting energy cost required to keep vital organs functioning (brain, liver, heart, kidneys, and lungs) while completely inactive in a thermoneutral environment.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hairline text-[11px] text-mute font-medium">
          Determined by: Lean body mass, age, sex, and height.
        </div>
      </div>

      <!-- NEAT Card -->
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-sm" style="font-family: var(--font-mono);">02</span>
            <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 px-2 py-0.5 rounded" style="font-family: var(--font-mono);">15 - 20%</span>
          </div>
          <h3 class="text-base font-bold text-ink mb-1.5">Non-Exercise Activity (NEAT)</h3>
          <p class="text-xs text-body leading-relaxed">
            All physical energy expended outside of deliberate workouts: walking to work, typing, taking the stairs, cleaning, posture maintenance, and pacing.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hairline text-[11px] text-mute font-medium">
          The single biggest variable determining fat loss success.
        </div>
      </div>

      <!-- TEF Card -->
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="w-8 h-8 rounded-lg bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-sm" style="font-family: var(--font-mono);">03</span>
            <span class="text-xs font-bold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/50 px-2 py-0.5 rounded" style="font-family: var(--font-mono);">8 - 10%</span>
          </div>
          <h3 class="text-base font-bold text-ink mb-1.5">Thermic Effect of Food (TEF)</h3>
          <p class="text-xs text-body leading-relaxed">
            The metabolic cost of breaking down, digesting, and absorbing food. Dietary protein requires the highest metabolic energy (~20–30% of ingested calories) compared to fats (0–3%).
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hairline text-[11px] text-mute font-medium">
          Elevated significantly with high-protein diets.
        </div>
      </div>

      <!-- EAT Card -->
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="w-8 h-8 rounded-lg bg-violet-50 dark:bg-violet-950/50 text-violet-600 dark:text-violet-400 flex items-center justify-center font-bold text-sm" style="font-family: var(--font-mono);">04</span>
            <span class="text-xs font-bold text-violet-600 dark:text-violet-400 bg-violet-50 dark:bg-violet-950/50 px-2 py-0.5 rounded" style="font-family: var(--font-mono);">5 - 10%</span>
          </div>
          <h3 class="text-base font-bold text-ink mb-1.5">Exercise Activity (EAT)</h3>
          <p class="text-xs text-body leading-relaxed">
            The energy expended during intentional cardiovascular, resistance, or sports training sessions. While crucial for cardiac health and muscle retention, it represents a minor portion of total daily burn.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hairline text-[11px] text-mute font-medium">
          Often severely overestimated by smartwatches.
        </div>
      </div>

    </div>
  </section>

  <!-- 14-DAY CALIBRATION PROTOCOL -->
  <section id="calibration" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 border-t border-hairline">
    <div class="bg-canvas-elevated border border-hairline rounded-2xl p-8 sm:p-10 shadow-xs">
      <div class="max-w-3xl mb-8">
        <span class="text-xs font-semibold uppercase tracking-wider text-ink" style="font-family: var(--font-mono);">Practical Protocol</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight mt-1 mb-3">How to Find Your Exact Maintenance in 14 Days</h2>
        <p class="text-body text-sm leading-relaxed">
          No mathematical formula in the world can account for individual metabolic nuances, gut biome differences, or subtle fidgeting habits. Use our calculator as your baseline starting point, then follow this clinical calibration protocol:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="flex flex-col gap-2 border-l-2 border-ink pl-4">
          <span class="text-xs font-bold text-ink" style="font-family: var(--font-mono);">PHASE 1: THE BASELINE</span>
          <h3 class="text-sm font-semibold text-ink">Eat Exactly Your Calculated TDEE</h3>
          <p class="text-xs text-body leading-relaxed">
            Consume the exact calorie target calculated above every day for 14 consecutive days. Log all food with a digital kitchen scale for complete precision. If weighing pre-cooked meats or meal-prepped grains, convert values with the <a href="https://rawtocookedcalculator.com/" target="_blank" rel="noopener" class="text-ink font-medium underline underline-offset-2 hover:opacity-80 transition-opacity">Raw to Cooked Calculator</a> to account for moisture loss and grain expansion accurately.
          </p>
        </div>

        <div class="flex flex-col gap-2 border-l-2 border-ink pl-4">
          <span class="text-xs font-bold text-ink" style="font-family: var(--font-mono);">PHASE 2: WEIGH-IN PROTOCOL</span>
          <h3 class="text-sm font-semibold text-ink">Track Morning Weight Daily</h3>
          <p class="text-xs text-body leading-relaxed">
            Step on the scale every morning immediately after waking and using the restroom, before consuming water or food. Calculate the 7-day average for Week 1 and Week 2.
          </p>
        </div>

        <div class="flex flex-col gap-2 border-l-2 border-ink pl-4">
          <span class="text-xs font-bold text-ink" style="font-family: var(--font-mono);">PHASE 3: CALIBRATION</span>
          <h3 class="text-sm font-semibold text-ink">Evaluate 14-Day Trajectory</h3>
          <p class="text-xs text-body leading-relaxed">
            If your 7-day average is unchanged (±0.3 lbs), that number is your true biological maintenance. If you lost 0.5 lbs, add 250 kcal/day. If you gained 0.5 lbs, subtract 250 kcal/day.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SCIENTIFIC FORMULA COMPARISON TABLE -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16 border-t border-hairline">
    <div class="max-w-3xl mb-8">
      <span class="text-xs font-semibold uppercase tracking-wider text-mute" style="font-family: var(--font-mono);">Methodology Comparison</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight mt-1 mb-2">Scientific Formulas Explained</h2>
      <p class="text-body text-sm leading-relaxed">
        Our calculator allows you to toggle between the three most validated equations in sports nutrition literature:
      </p>
    </div>

    <div class="overflow-x-auto bg-canvas-elevated rounded-2xl border border-hairline shadow-xs max-w-full overscroll-x-contain">
      <table class="w-full min-w-[550px] text-left text-xs sm:text-sm">
        <thead class="bg-canvas border-b border-hairline font-semibold text-ink uppercase tracking-wider text-[11px]" style="font-family: var(--font-mono);">
          <tr>
            <th class="py-3.5 px-4 sm:px-6">Formula</th>
            <th class="py-3.5 px-4 sm:px-6">Key Variables Used</th>
            <th class="py-3.5 px-4 sm:px-6">Primary Benefit</th>
            <th class="py-3.5 px-4 sm:px-6">Best Suited For</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-body">
          <tr class="hover:bg-canvas/50 transition-colors">
            <td class="py-4 px-4 sm:px-6 font-bold text-ink">Mifflin-St Jeor (1990)</td>
            <td class="py-4 px-4 sm:px-6">Weight, Height, Age, Biological Sex</td>
            <td class="py-4 px-4 sm:px-6">Endorsed by the Academy of Nutrition and Dietetics as the most accurate without body composition measurements.</td>
            <td class="py-4 px-4 sm:px-6"><span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 font-medium">General Public</span></td>
          </tr>
          <tr class="hover:bg-canvas/50 transition-colors">
            <td class="py-4 px-4 sm:px-6 font-bold text-ink">Katch-McArdle (1996)</td>
            <td class="py-4 px-4 sm:px-6">Lean Body Mass (LBM) via Body Fat %</td>
            <td class="py-4 px-4 sm:px-6">Accounts for the metabolic expenditure of muscle mass versus inert fat tissue.</td>
            <td class="py-4 px-4 sm:px-6"><span class="px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-400 font-medium">Athletes & Lifters</span></td>
          </tr>
          <tr class="hover:bg-canvas/50 transition-colors">
            <td class="py-4 px-4 sm:px-6 font-bold text-ink">Revised Harris-Benedict (1984)</td>
            <td class="py-4 px-4 sm:px-6">Weight, Height, Age, Biological Sex</td>
            <td class="py-4 px-4 sm:px-6">Historic clinical standard, updated by Roza and Shizgal to remove older 1919 biases.</td>
            <td class="py-4 px-4 sm:px-6"><span class="px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/50 text-purple-700 dark:text-purple-400 font-medium">Clinical Reference</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- MACRO GUIDE SECTION -->
  <section id="macros" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 border-t border-hairline">
    <div class="max-w-3xl mb-10">
      <span class="text-xs font-semibold uppercase tracking-wider text-mute" style="font-family: var(--font-mono);">Nutritional Science</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight mt-1 mb-2">How to Set Your Macronutrients for Optimal Results</h2>
      <p class="text-body text-sm leading-relaxed">
        While total calories determine whether you gain or lose weight, your macronutrient distribution determines what kind of tissue you gain or lose:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Protein -->
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 shadow-xs flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[var(--color-grad-blue)]"></span>
          <h3 class="text-base font-bold text-ink">Protein (4 kcal / gram)</h3>
        </div>
        <p class="text-xs text-body leading-relaxed">
          The structural building block for lean tissue repair and muscle protein synthesis. High protein diets maximize satiety, protect muscle during a caloric deficit, and elevate TEF.
        </p>
        <div class="mt-auto bg-canvas p-3 rounded-xl border border-hairline text-xs font-medium text-ink">
          <strong>Optimal Target:</strong> 0.8 to 1.0 grams per pound of total bodyweight (1.6–2.2g/kg).
        </div>
      </div>

      <!-- Fats -->
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 shadow-xs flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[var(--color-grad-magenta)]"></span>
          <h3 class="text-base font-bold text-ink">Fats (9 kcal / gram)</h3>
        </div>
        <p class="text-xs text-body leading-relaxed">
          Crucial for endocrine function, testosterone and estrogen synthesis, cell membrane integrity, and fat-soluble vitamin absorption (Vitamins A, D, E, K).
        </p>
        <div class="mt-auto bg-canvas p-3 rounded-xl border border-hairline text-xs font-medium text-ink">
          <strong>Optimal Target:</strong> 20% to 30% of total daily calories (minimum 0.3g per lb).
        </div>
      </div>

      <!-- Carbs -->
