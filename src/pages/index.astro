---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';

const seoTitle = "Free TDEE Calculator & Maintenance Calorie Calculator | TDEE Calc";
const seoDescription = "Use our free TDEE calculator to calculate TDEE and maintenance calories. Discover what is TDEE, the exact TDEE meaning, BMR, and macro targets with clinical precision.";
const seoKeywords = "maintenance calorie calculator, tdee calculator, tdee, tdee calculator free, tdee calc, what is tdee, free tdee calculator, calculate tdee, tdee meaning, calculate maintenance calories, bmr and tdee calculator, most accurate maintenance calorie calculator";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free TDEE Calculator & Maintenance Calorie Calculator",
  "alternateName": [
    "TDEE Calculator",
    "Free TDEE Calculator",
    "TDEE Calc",
    "Maintenance Calorie Calculator",
    "TDEE and Maintenance Calories Calculator",
    "Calculate TDEE"
  ],
  "url": "https://freemaintenancecaloriescalculator.com/",
  "description": "Free TDEE calculator and maintenance calorie calculator. Calculate your daily calories, BMR, and macro targets using peer-reviewed Mifflin-St Jeor and Katch-McArdle equations.",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Calculate TDEE (Total Daily Energy Expenditure)",
    "Maintenance calorie calculator for weight loss and muscle gain",
    "Free TDEE calc with Mifflin-St Jeor formula",
    "Katch-McArdle formula using Lean Body Mass (LBM)",
    "Revised Harris-Benedict baseline comparison",
    "Interactive macronutrient distribution (Protein, Fats, Carbs)",
    "Meal frequency calorie & protein breakdown",
    "100% Free with zero registration or paywalls"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is TDEE and what is the meaning of TDEE?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TDEE stands for Total Daily Energy Expenditure. The meaning of TDEE is the total number of calories your body burns in a single 24-hour day across all metabolic processes: Basal Metabolic Rate (BMR, 60-70%), Non-Exercise Activity Thermogenesis (NEAT, 15-20%), Exercise Activity Thermogenesis (EAT, 5-10%), and the Thermic Effect of Food (TEF, 8-10%). In nutrition and fitness, your TDEE is identical to your maintenance calories."
      }
    },
    {
      "@type": "Question",
      "name": "How do I calculate TDEE?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To calculate TDEE: First, compute your Basal Metabolic Rate (BMR) using the Mifflin-St Jeor formula: [10 × weight in kg] + [6.25 × height in cm] - [5 × age] + s (+5 for men, -161 for women). Second, multiply your BMR by your Physical Activity Level (PAL) multiplier (1.2 for sedentary, 1.375 for lightly active, 1.55 for moderately active, 1.725 for very active, or 1.9 for extremely active). The result is your daily TDEE (maintenance calories). You can also use our free TDEE calculator above to calculate it instantly."
      }
    },
    {
      "@type": "Question",
      "name": "Is this TDEE calculator completely free to use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, our TDEE calculator is 100% free with no hidden fees, paid subscriptions, or email sign-up requirements. You get unrestricted access to validated Mifflin-St Jeor, Katch-McArdle, and Harris-Benedict algorithms, customized macro distributions, and deficit/surplus caloric targets."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between TDEE and maintenance calories?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TDEE (Total Daily Energy Expenditure) and maintenance calories refer to the exact same caloric figure. TDEE is the physiological term describing total daily energy burn, while maintenance calories is the dietary term describing the daily caloric intake needed to match that expenditure and keep your body weight unchanged."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between BMR and TDEE?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BMR (Basal Metabolic Rate) is the baseline number of calories required to sustain involuntary biological life at complete rest (brain function, heart beating, respiration). TDEE (Total Daily Energy Expenditure) is your BMR plus all calories burned through daily movement, digestion, and structured exercise. TDEE is always higher than BMR, and you should avoid consuming fewer calories than your BMR for extended periods."
      }
    },
    {
      "@type": "Question",
      "name": "How accurate is this free TDEE calc?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our free TDEE calc is accurate within ±5% for the vast majority of healthy adults when using the Mifflin-St Jeor formula. When using the Katch-McArdle formula with a known body fat percentage, precision increases even further because it measures metabolically active Lean Body Mass rather than gross body weight."
      }
    },
    {
      "@type": "Question",
      "name": "what is my calorie maintenance calculator?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A calorie maintenance calculator is an evidence-based nutritional tool that determines your Total Daily Energy Expenditure (TDEE). It calculates the exact number of calories your body burns every 24 hours across resting organ function (BMR), non-exercise activity (NEAT), intentional workouts (EAT), and food digestion (TEF). Eating at this caloric target maintains your current body weight."
      }
    },
    {
      "@type": "Question",
      "name": "how accurate is maintenance calorie calculator?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When powered by clinical formulas like Mifflin-St Jeor, a maintenance calorie calculator is accurate within ±5% for the vast majority of healthy adults. When utilizing the Katch-McArdle formula with a known body fat percentage, precision increases further because it measures metabolically active Lean Body Mass rather than total weight."
      }
    },
    {
      "@type": "Question",
      "name": "which maintenance calorie calculator is best?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The best maintenance calorie calculator is one that provides transparent, clinically validated formulas (Mifflin-St Jeor for standard populations and Katch-McArdle for lean athletic individuals) rather than outdated 1919 Harris-Benedict formulas or arbitrary fitness tracker estimations. It should also calculate granular macronutrient splits and meal frequency distributions."
      }
    },
    {
      "@type": "Question",
      "name": "calorie maintenance calculator how to calculate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To calculate maintenance calories: First, compute your Basal Metabolic Rate (BMR) using Mifflin-St Jeor: [10 × weight in kg] + [6.25 × height in cm] - [5 × age] + s (+5 for men, -161 for women). Second, multiply your BMR by your physical activity multiplier (1.2 for sedentary up to 1.9 for extremely active). The resulting number is your daily maintenance calories."
      }
    },
    {
      "@type": "Question",
      "name": "How do I calculate what my maintenance calories should be?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can calculate your maintenance calories instantly using our free calculator above by entering your age, biological sex, height, current body weight, and daily activity level. Alternatively, you can use the 14-day empirical method: eat a consistent calorie target for two weeks while tracking morning weight; if your 7-day average remains stable, that caloric intake is your true maintenance level."
      }
    },
    {
      "@type": "Question",
      "name": "Is 1200 calories enough for maintenance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, for virtually all adults, 1200 calories is not enough for maintenance. A 1200-calorie diet is typically below the resting Basal Metabolic Rate (BMR) of adult humans, meaning it fails to provide adequate energy for basic cellular respiration, cardiac function, and liver metabolism. Sustaining 1200 calories long-term often causes metabolic adaptation, fatigue, and nutrient deficiencies."
      }
    },
    {
      "@type": "Question",
      "name": "Is 2000 calories a day maintenance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A 2000 calorie intake is a common national average used on nutrition facts labels, but individual maintenance varies widely. For an average sedentary to lightly active female, maintenance is typically 1,800 to 2,200 calories. For an active adult male, maintenance frequently ranges from 2,400 to 3,000+ calories depending on body weight, muscle mass, and step count."
      }
    },
    {
      "@type": "Question",
      "name": "What is the most accurate formula for maintenance calories?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Mifflin-St Jeor equation is clinically proven as the most accurate standard formula for general populations where body composition is unknown. For athletic or lean individuals who know their body fat percentage, the Katch-McArdle formula is even more accurate because it calculates energy expenditure directly from Lean Body Mass (LBM)."
      }
    },
    {
      "@type": "Question",
      "name": "What is a normal amount of maintenance calories?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Normal maintenance calories for adult women generally fall between 1,800 and 2,400 calories per day, and for adult men between 2,200 and 3,000 calories per day. Factors such as height, age, muscle mass, occupation, and daily step volume cause natural variations around these ranges."
      }
    },
    {
      "@type": "Question",
      "name": "Is it better to eat 1200 or 1500 calories a day?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For the vast majority of people aiming to lose weight, eating 1500 calories is vastly better than 1200 calories. A 1500-calorie target preserves lean muscle tissue, supports thyroid hormone output, provides essential micronutrients, and prevents the ravenous rebound binging associated with extreme 1200-calorie crash diets."
      }
    },
    {
      "@type": "Question",
      "name": "Is 1200 calories enough for a 5'5\" woman?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, 1200 calories is not enough for maintenance for a 5'5\" woman. An average 5'5\" woman weighing 135 to 150 lbs has a resting BMR of 1,350 to 1,450 calories and a maintenance TDEE between 1,800 and 2,200 calories. Consuming 1200 calories places her in an aggressive deficit that can cause hormonal disruption, hair thinning, and lethargy."
      }
    },
    {
      "@type": "Question",
      "name": "How long will it take to lose 20 pounds on a 1500 calorie diet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If your maintenance TDEE is 2,000 calories, consuming 1,500 calories creates a daily 500-calorie deficit (3,500 calories per week), which equals roughly 1 pound of fat loss per week. At this safe and sustainable rate, losing 20 pounds will take approximately 20 to 24 weeks (around 5 months)."
      }
    },
    {
      "@type": "Question",
      "name": "How much will you weigh if you eat 1500 calories a day?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If you consistently eat 1,500 calories a day, your body weight will gradually drop until 1,500 calories becomes your new biological maintenance expenditure. For an average sedentary adult female, 1,500 calories will eventually stabilize body weight at roughly 105 to 115 lbs, whereas for larger or active individuals it will continue downward until metabolic adaptation and mass loss equalize."
      }
    },
    {
      "@type": "Question",
      "name": "How many eggs are 1500 calories?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "One large whole egg contains approximately 72 calories and 6 grams of protein. Therefore, 1,500 calories equates to approximately 21 large whole eggs, providing roughly 126 grams of complete protein and 105 grams of dietary fats."
      }
    },
    {
      "@type": "Question",
      "name": "How many calories a day to lose 2 pounds a week?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To lose 2 pounds of fat per week, you need a daily caloric deficit of 1,000 calories below your maintenance TDEE (since 2 lbs of adipose tissue equates to ~7,000 calories). For example, if your maintenance is 2,600 calories, you must consume 1,600 calories per day. Note that daily deficits over 1,000 calories are aggressive and primarily suited for individuals with significant weight to lose."
      }
    },
    {
      "@type": "Question",
      "name": "How many calories do 10,000 steps burn 300 lbs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A person weighing 300 lbs (136 kg) burns approximately 700 to 900 calories walking 10,000 steps (about 4.5 to 5 miles). Because physical workload and energy expenditure are directly proportional to body mass moved against gravity, a 300 lb individual expends nearly double the calories of a 150 lb person completing the exact same distance."
      }
    },
    {
      "@type": "Question",
      "name": "Should I weigh food raw or cooked when tracking maintenance calories?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nutrition databases and food labels almost universally reference raw, uncooked food weights unless stated otherwise. Cooking fundamentally alters weight through moisture loss (meats shrink 20% to 30%, making them more calorie-dense) or water absorption (rice and pasta expand 2 to 3 times, diluting calorie density). If measuring cooked meals or meal prep, convert values using the Raw to Cooked Food Calculator (https://rawtocookedcalculator.com/) to maintain true caloric accuracy."
      }
    }
  ]
};
---

<Layout title={seoTitle} description={seoDescription} keywords={seoKeywords}>
  <!-- JSON-LD Schemas for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION -->
  <section class="relative pt-16 pb-12 px-4 sm:px-6 overflow-hidden flex flex-col items-center text-center">
    <div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center gap-4">
      <!-- Technical Eyebrow Label -->
      <span class="inline-flex items-center justify-center gap-1.5 px-3 py-1 rounded-full bg-canvas-elevated border border-hairline text-[11px] sm:text-xs font-semibold text-ink shadow-xs max-w-full text-center" style="font-family: var(--font-mono);">
        <span class="w-2 h-2 rounded-full bg-emerald-500 flex-shrink-0"></span>
        <span class="truncate sm:whitespace-normal">Peer-Reviewed Metabolic Algorithms • 100% Free TDEE Calc</span>
      </span>

      <!-- Primary H1 Display Title -->
      <h1 class="text-3xl xs:text-4xl sm:text-6xl font-extrabold text-ink tracking-tight leading-[1.1] break-words" style="letter-spacing: -1.5px;">
        Free TDEE Calculator & Maintenance Calorie Calculator
      </h1>

      <!-- Subtitle with Secondary Keywords -->
      <p class="text-base sm:text-lg text-body max-w-2xl mx-auto leading-relaxed">
        Calculate TDEE and daily maintenance calories with clinical precision. Our free TDEE calculator uses peer-reviewed Mifflin-St Jeor and Katch-McArdle equations to accurately determine your Total Daily Energy Expenditure, BMR, and custom macro targets for fat loss, maintenance, or muscle gain.
      </p>

      <!-- Trust Badges -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2 text-xs text-mute" style="font-family: var(--font-mono);">
        <span class="flex items-center gap-1.5">✓ 100% Free TDEE Calc</span>
        <span class="flex items-center gap-1.5">✓ Mifflin-St Jeor</span>
        <span class="flex items-center gap-1.5">✓ Katch-McArdle</span>
        <span class="flex items-center gap-1.5">✓ Harris-Benedict</span>
        <span class="flex items-center gap-1.5">✓ Instant Macro Splits</span>
      </div>
    </div>
  </section>

  <!-- CALCULATOR SECTION -->
  <section id="calculator" class="px-4 sm:px-6 py-6 z-10 relative">
    <Calculator lang="en" />
  </section>

  <!-- WHAT IS TDEE & TDEE MEANING SECTION (FEATURED SNIPPET TARGET) -->
  <section id="what-is-tdee" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 border-t border-hairline mt-12">
    <div class="max-w-3xl mb-8">
      <span class="text-xs font-semibold uppercase tracking-wider text-mute" style="font-family: var(--font-mono);">Metabolic Fundamentals</span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-ink tracking-tight mt-1 mb-3">
        What is TDEE? (TDEE Meaning Explained)
      </h2>
      <p class="text-body text-sm sm:text-base leading-relaxed">
        If you are embarking on a weight loss, muscle building, or body recomposition journey, knowing your <strong>TDEE</strong> is the single most critical number in your nutrition plan.
      </p>
    </div>

    <!-- Featured Snippet Definition Callout Box -->
    <div class="bg-canvas-elevated border-2 border-ink/20 rounded-2xl p-6 sm:p-8 shadow-sm mb-10">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-ink font-mono">Quick Definition</span>
      </div>
      <p class="text-base sm:text-lg text-ink font-medium leading-relaxed">
        <strong>TDEE stands for Total Daily Energy Expenditure.</strong> The meaning of TDEE is the comprehensive measure of all calories your body burns over a full 24-hour day across involuntary organ function (BMR), non-exercise physical movement (NEAT), planned workouts (EAT), and the thermic effect of food digestion (TEF). In health and sports nutrition, <strong>TDEE is identical to your maintenance calories</strong>—eating this exact number of calories keeps your body weight perfectly stable.
      </p>
    </div>

    <!-- TDEE Acronym Breakdown Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
      <div class="bg-canvas-elevated border border-hairline rounded-xl p-5 flex flex-col gap-2">
        <span class="text-2xl font-black text-ink font-mono">T</span>
        <h3 class="text-sm font-bold text-ink">Total</h3>
        <p class="text-xs text-body leading-relaxed">
          The sum of every biological and physical activity in your body combined into one daily caloric figure.
        </p>
      </div>
      <div class="bg-canvas-elevated border border-hairline rounded-xl p-5 flex flex-col gap-2">
        <span class="text-2xl font-black text-ink font-mono">D</span>
        <h3 class="text-sm font-bold text-ink">Daily</h3>
        <p class="text-xs text-body leading-relaxed">
          Measured across an average 24-hour cycle to smooth out day-to-day variations in steps, workouts, and digestion.
        </p>
      </div>
      <div class="bg-canvas-elevated border border-hairline rounded-xl p-5 flex flex-col gap-2">
        <span class="text-2xl font-black text-ink font-mono">E</span>
        <h3 class="text-sm font-bold text-ink">Energy</h3>
        <p class="text-xs text-body leading-relaxed">
          Expressed in nutritional calories (kilocalories or kcal) consumed from food and beverages.
        </p>
      </div>
      <div class="bg-canvas-elevated border border-hairline rounded-xl p-5 flex flex-col gap-2">
        <span class="text-2xl font-black text-ink font-mono">E</span>
        <h3 class="text-sm font-bold text-ink">Expenditure</h3>
        <p class="text-xs text-body leading-relaxed">
          The rate at which energy is oxidized for survival, organ maintenance, thermoregulation, and muscular motion.
        </p>
      </div>
    </div>

    <!-- TDEE vs BMR vs Maintenance Calories Comparison Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 flex flex-col gap-2">
        <h3 class="text-base font-bold text-ink">TDEE vs Maintenance Calories: What's the Difference?</h3>
        <p class="text-xs sm:text-sm text-body leading-relaxed">
          There is no mathematical difference between TDEE and maintenance calories. <strong>TDEE</strong> is the physiological term describing the total amount of energy your body expends each day. <strong>Maintenance calories</strong> is the dietary term describing the amount of food energy you must consume to balance that expenditure. If your TDEE is 2,400 calories, your daily maintenance caloric target is also exactly 2,400 calories.
        </p>
      </div>

      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 flex flex-col gap-2">
        <h3 class="text-base font-bold text-ink">TDEE vs BMR: Why You Should Never Confuse the Two</h3>
        <p class="text-xs sm:text-sm text-body leading-relaxed">
          <strong>Basal Metabolic Rate (BMR)</strong> represents only the energy burned while in a coma or sleeping in a temperature-controlled room (60% to 70% of total burn). <strong>TDEE</strong> includes your BMR <em>plus</em> all movement, standing, fidgeting, workouts, and food digestion. A common dieting mistake is consuming calories at or below your BMR, which can trigger hormonal crashes, thyroid suppression, and severe muscle loss.
        </p>
      </div>
    </div>
  </section>

  <!-- HOW TO CALCULATE TDEE SECTION -->
  <section id="how-to-calculate-tdee" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 border-t border-hairline">
    <div class="max-w-3xl mb-8">
      <span class="text-xs font-semibold uppercase tracking-wider text-mute" style="font-family: var(--font-mono);">Step-by-Step Math</span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-ink tracking-tight mt-1 mb-3">
        How to Calculate TDEE: Step-by-Step Guide with Formulas
      </h2>
      <p class="text-body text-sm sm:text-base leading-relaxed">
        Calculating your TDEE manually requires two evidence-based steps: calculating your Basal Metabolic Rate (BMR) and applying your Physical Activity Level (PAL) multiplier.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <!-- Step 1 -->
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <span class="w-7 h-7 rounded-lg bg-ink text-canvas font-mono font-bold text-xs flex items-center justify-center">01</span>
          <span class="text-xs font-mono text-mute uppercase font-semibold">Step One</span>
        </div>
        <h3 class="text-base font-bold text-ink">Calculate BMR</h3>
        <p class="text-xs text-body leading-relaxed">
          Use the clinically validated <strong>Mifflin-St Jeor formula</strong>:
        </p>
        <div class="bg-canvas p-3 rounded-xl border border-hairline font-mono text-[11px] text-ink space-y-1">
          <div><strong>Men:</strong> (10 × wt kg) + (6.25 × ht cm) - (5 × age) + 5</div>
          <div><strong>Women:</strong> (10 × wt kg) + (6.25 × ht cm) - (5 × age) - 161</div>
        </div>
        <p class="text-[11px] text-mute mt-auto">
          Or use Katch-McArdle if you know your body fat %: BMR = 370 + (21.6 × LBM in kg).
        </p>
      </div>

      <!-- Step 2 -->
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <span class="w-7 h-7 rounded-lg bg-ink text-canvas font-mono font-bold text-xs flex items-center justify-center">02</span>
          <span class="text-xs font-mono text-mute uppercase font-semibold">Step Two</span>
        </div>
        <h3 class="text-base font-bold text-ink">Apply Activity Multiplier</h3>
        <p class="text-xs text-body leading-relaxed">
          Multiply your BMR by your realistic weekly physical activity level:
        </p>
        <div class="bg-canvas p-3 rounded-xl border border-hairline font-mono text-[11px] text-ink space-y-1">
          <div>• <strong>Sedentary:</strong> BMR × 1.2</div>
          <div>• <strong>Light Activity:</strong> BMR × 1.375</div>
          <div>• <strong>Moderate Activity:</strong> BMR × 1.55</div>
          <div>• <strong>Very Active:</strong> BMR × 1.725</div>
          <div>• <strong>Extremely Active:</strong> BMR × 1.9</div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <span class="w-7 h-7 rounded-lg bg-ink text-canvas font-mono font-bold text-xs flex items-center justify-center">03</span>
          <span class="text-xs font-mono text-mute uppercase font-semibold">Step Three</span>
        </div>
        <h3 class="text-base font-bold text-ink">Adjust for Your Goal</h3>
        <p class="text-xs text-body leading-relaxed">
          Your TDEE output is your maintenance baseline. Adjust intake to meet your objective:
        </p>
        <div class="bg-canvas p-3 rounded-xl border border-hairline text-[11px] text-ink space-y-1.5">
          <div><strong>Weight Loss (Cut):</strong> Subtract 300 to 500 kcal/day (0.5 to 1 lb fat loss/week).</div>
          <div><strong>Weight Maintenance:</strong> Eat exactly 100% of your TDEE.</div>
          <div><strong>Muscle Building (Lean Bulk):</strong> Add 200 to 300 kcal/day.</div>
        </div>
      </div>
    </div>

    <!-- Quick CTA banner -->
    <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h4 class="text-sm sm:text-base font-bold text-ink">Don't want to do the math manually?</h4>
        <p class="text-xs text-mute mt-0.5">Our free TDEE calculator calculates your BMR, TDEE, and optimal protein/fat/carb macros in milliseconds.</p>
      </div>
      <a href="#calculator" class="px-5 py-2.5 rounded-xl bg-ink text-canvas font-semibold text-xs whitespace-nowrap hover:opacity-90 transition-opacity shadow-xs">
        Calculate TDEE Now ↑
      </a>
    </div>
  </section>

  <!-- THE 4 PILLARS OF ENERGY EXPENDITURE -->
  <section id="science" class="max-w-6xl mx-auto px-4 sm:px-6 py-20 border-t border-hairline">
    <div class="max-w-3xl mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-mute" style="font-family: var(--font-mono);">Energy Science</span>
