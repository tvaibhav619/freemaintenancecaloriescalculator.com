---
import Layout from '../layouts/Layout.astro';

const title = "404 - Page Not Found | FreeMaintenanceCaloriesCalculator.com";
const description = "The page you are looking for does not exist or has been moved. Return to the Free Maintenance Calories Calculator.";
---

<Layout title={title} description={description} noindex={true}>
  <div class="min-h-[70vh] flex items-center justify-center px-4 sm:px-6 py-20">
    <div class="max-w-lg w-full bg-canvas-elevated border border-hairline rounded-2xl p-8 sm:p-10 text-center shadow-xs flex flex-col items-center">
      
      <!-- Monospace Error Badge -->
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas border border-hairline text-xs font-semibold text-mute tracking-wider uppercase mb-6" style="font-family: var(--font-mono);">
        <span class="w-2 h-2 rounded-full bg-red-500"></span>
        Error 404 • Not Found
      </span>

      <!-- Display Code -->
      <h1 class="text-6xl sm:text-7xl font-extrabold text-ink tracking-tight mb-3" style="font-family: var(--font-mono); letter-spacing: -3px;">
        404
      </h1>

      <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight mb-3">
        Page Expended from Energy Balance
      </h2>

      <p class="text-sm text-body leading-relaxed mb-8">
        The link you followed may be broken, or the page may have been removed. Use the buttons below to return to our calorie calculation tools.
      </p>

      <!-- Quick Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full">
        <a href="/" class="w-full sm:w-auto bg-primary text-on-primary hover:opacity-90 font-medium text-xs sm:text-sm px-6 py-2.5 rounded-full transition-all shadow-xs">
          Return to Calculator
        </a>
        <a href="/#faq" class="w-full sm:w-auto bg-canvas hover:bg-canvas-elevated border border-hairline text-ink font-medium text-xs sm:text-sm px-6 py-2.5 rounded-full transition-all">
          Browse FAQs
        </a>
      </div>

    </div>
  </div>
</Layout>
