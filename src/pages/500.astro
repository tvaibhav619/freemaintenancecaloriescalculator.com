---
import Layout from '../layouts/Layout.astro';

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
const title = "500 - Server Error | FreeMaintenanceCaloriesCalculator.com";
const description = "An unexpected server error occurred. Please try again or return to the Free Maintenance Calories Calculator.";
---

<Layout title={title} description={description} noindex={true}>
  <div class="min-h-[70vh] flex items-center justify-center px-4 sm:px-6 py-20">
    <div class="max-w-lg w-full bg-canvas-elevated border border-hairline rounded-2xl p-8 sm:p-10 text-center shadow-xs flex flex-col items-center">
      
      <!-- Monospace Error Badge -->
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas border border-hairline text-xs font-semibold text-mute tracking-wider uppercase mb-6" style="font-family: var(--font-mono);">
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        Error 500 • Server Error
      </span>

      <!-- Display Code -->
      <h1 class="text-6xl sm:text-7xl font-extrabold text-ink tracking-tight mb-3" style="font-family: var(--font-mono); letter-spacing: -3px;">
        500
      </h1>

      <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight mb-3">
        Metabolic Calculation Interrupted
      </h2>

      <p class="text-sm text-body leading-relaxed mb-8">
        An unexpected internal server error occurred while processing your request. Please try refreshing the page or navigating back to our calculator tools.
      </p>

      <!-- Quick Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full">
        <button type="button" onclick="window.location.reload()" class="w-full sm:w-auto bg-primary text-on-primary hover:opacity-90 font-medium text-xs sm:text-sm px-6 py-2.5 rounded-full transition-all shadow-xs">
          Reload Page
        </button>
        <a href="/" class="w-full sm:w-auto bg-canvas hover:bg-canvas-elevated border border-hairline text-ink font-medium text-xs sm:text-sm px-6 py-2.5 rounded-full transition-all">
          Return to Homepage
        </a>
      </div>

    </div>
  </div>
</Layout>
