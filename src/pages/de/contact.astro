---
import Layout from '../../layouts/Layout.astro';

const title = "Kundensupport & Kontakt | FreeMaintenanceCaloriesCalculator.com";
const description = "Kontaktieren Sie das Team von FreeMaintenanceCaloriesCalculator.com für Fragen zu Berechnungsformeln, Feedback oder Support.";
---

<Layout title={title} description={description}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <div class="border-b border-hairline pb-8 mb-10 text-center">
      <span class="text-xs font-semibold uppercase tracking-wider text-mute" style="font-family: var(--font-mono);">Support & Kontakt</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight mt-1 mb-2">Kundensupport & Kontakt</h1>
      <p class="text-sm text-body max-w-md mx-auto mb-4">
        Haben Sie Fragen zu unseren Stoffwechsel-Formeln, einen Fehler entdeckt oder einen Verbesserungsvorschlag? Wir freuen uns über Ihre Nachricht.
      </p>
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-canvas-elevated border border-hairline text-xs text-mute">
        <span>Offizielle E-Mail:</span>
        <a href="mailto:hello@freemaintenancecaloriecalculator.com" class="font-semibold text-ink hover:underline">hello@freemaintenancecaloriecalculator.com</a>
      </div>
    </div>

    <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 sm:p-8 shadow-xs">
      <form id="contact-form" class="flex flex-col gap-5">
        <div>
          <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-ink mb-1.5" style="font-family: var(--font-mono);">Ihr Name</label>
          <input type="text" id="name" name="name" required placeholder="Vorname Nachname" class="w-full bg-canvas text-ink border border-hairline rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all" />
        </div>

        <div>
          <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-ink mb-1.5" style="font-family: var(--font-mono);">E-Mail-Adresse</label>
          <input type="email" id="email" name="email" required placeholder="name@beispiel.de" class="w-full bg-canvas text-ink border border-hairline rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all" />
        </div>

        <div>
          <label for="subject" class="block text-xs font-semibold uppercase tracking-wider text-ink mb-1.5" style="font-family: var(--font-mono);">Betreff</label>
          <select id="subject" name="subject" class="w-full bg-canvas text-ink border border-hairline rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all">
            <option value="feedback">Allgemeines Feedback & Anregungen</option>
            <option value="bug">Fehler melden / Berechnungsabweichung</option>
            <option value="formula">Frage zu wissenschaftlichen Formeln</option>
            <option value="business">Geschäftliche & Medienanfragen</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-ink mb-1.5" style="font-family: var(--font-mono);">Ihre Nachricht</label>
          <textarea id="message" name="message" rows="5" required placeholder="Schreiben Sie Ihre Nachricht hier..." class="w-full bg-canvas text-ink border border-hairline rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all"></textarea>
        </div>

        <button type="submit" id="submit-btn" class="bg-primary text-on-primary hover:bg-black font-semibold text-sm py-3 px-6 rounded-xl transition-all shadow-xs self-start">
          Nachricht Senden
        </button>
        <p id="form-status" class="text-xs text-emerald-600 font-medium hidden">Vielen Dank! Ihre Nachricht wurde erfolgreich übermittelt.</p>
      </form>
    </div>

    <script>
      const form = document.getElementById("contact-form") as HTMLFormElement;
      const status = document.getElementById("form-status") as HTMLElement;
      const btn = document.getElementById("submit-btn") as HTMLButtonElement;

      form?.addEventListener("submit", (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.innerText = "Wird gesendet...";
        setTimeout(() => {
          form.reset();
          btn.disabled = false;
          btn.innerText = "Nachricht Senden";
          status.classList.remove("hidden");
          setTimeout(() => status.classList.add("hidden"), 5000);
        }, 600);
      });
    </script>
  </div>
</Layout>
