---
import Layout from '../../layouts/Layout.astro';
import Calculator from '../../components/Calculator.astro';
import { seoMetadata } from '../../i18n/ui';

const seo = seoMetadata.de;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Erhaltungskalorien Rechner",
  "url": "https://freemaintenancecaloriescalculator.com/de/",
  "description": "Kostenloser Erhaltungskalorien-Rechner (TDEE & BMR) mit klinisch validierten Formeln wie Mifflin-St Jeor und Katch-McArdle.",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR"
  },
  "featureList": [
    "Klinisch validierte Mifflin-St Jeor Formel",
    "Katch-McArdle Formel für fettfreie Magermasse",
    "Revidierte Harris-Benedict Referenz",
    "Kaloriendefizit-Planer für nachhaltigen Fettabbau",
    "Überschuss-Kalkulator für sauberen Muskelaufbau",
    "Dynamische Makronährstoff-Verteilung",
    "Mahlzeitenbasierte Kalorien- und Proteinaufteilung"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was sind Erhaltungskalorien (TDEE)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Erhaltungskalorien (auch Gesamtenergieumsatz oder TDEE genannt) bezeichnen die genaue Anzahl an Kalorien, die Ihr Körper innerhalb von 24 Stunden verbrennt. Wenn Sie genau so viele Kalorien zu sich nehmen wie Sie verbrauchen, bleibt Ihr Körpergewicht stabil."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Formel ist am genauesten für die Berechnung des Kalorienbedarfs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Mifflin-St Jeor-Gleichung gilt international als Goldstandard für Normal- und Übergewichtige Personen. Für Kraftsportler und Athleten mit bekanntem Körperfettanteil liefert die Katch-McArdle-Formel die höchste Präzision, da sie die stoffwechselaktive Magermasse berücksichtigt."
      }
    },
    {
      "@type": "Question",
      "name": "Wie berechnet man die Erhaltungskalorien mathematisch?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Zuerst wird der Grundumsatz (BMR) mit der Mifflin-St Jeor-Formel berechnet: [10 × Gewicht in kg] + [6,25 × Größe in cm] - [5 × Alter] + s (+5 für Männer, -161 für Frauen). Dieser Wert wird anschließend mit dem Aktivitätsfaktor (PAL zwischen 1,2 und 1,9) multipliziert."
      }
    },
    {
      "@type": "Question",
      "name": "Sind 1200 Kalorien pro Tag für Erwachsene ausreichend?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nein. Für nahezu alle Erwachsenen liegt ein Wert von 1200 kcal deutlich unter dem lebensnotwendigen Grundumsatz (BMR). Eine derart drastische Restriktion führt zu Muskelabbau, Nährstoffmängeln und einer Verlangsamung des Stoffwechsels (adaptive Thermogenese)."
      }
    },
    {
      "@type": "Question",
      "name": "Wie hoch sollte das Defizit für 1 kg Fettabbau pro Woche sein?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Um 1 kg reines Körperfett abzubauen, wird ein rechnerisches Gesamtedefizit von rund 7.700 kcal benötigt. Dies entspricht einem täglichen Kaloriendefizit von ca. 1.000 bis 1.100 kcal unter Ihren Erhaltungskalorien."
      }
    },
    {
      "@type": "Question",
      "name": "Warum überschätzen Fitnesstracker und Laufbänder oft den Kalorienverbrauch?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Kardiogeräte und Wearables verwenden allgemeine Durchschnittswerte (METs) und berücksichtigen weder individuelle Stoffwechseleffizienz noch den genauen Körperfettanteil. Wissenschaftliche Untersuchungen belegen regelmäßige Überschätzungen zwischen 20% und 45%."
      }
    },
    {
      "@type": "Question",
      "name": "Sollte man Lebensmittel roh oder gekocht wiegen, um Kalorien genau zu erfassen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nährwerttabellen und Lebensmitteldatenbanken beziehen sich nahezu immer auf das Rohgewicht, sofern nicht ausdrücklich anders angegeben. Beim Kochen verändert sich das Gewicht drastisch durch Wasserverlust (Fleisch verliert 20–30 % an Gewicht, wodurch die Kaloriendichte steigt) oder Wasseraufnahme (Reis und Nudeln verdreifachen ihr Gewicht, wodurch die Kaloriendichte sinkt). Wenn Sie vorgekochte Mahlzeiten abwiegen, nutzen Sie den <a href=\"https://rawtocookedcalculator.com/\" target=\"_blank\" rel=\"noopener\" class=\"text-ink font-medium underline underline-offset-2 hover:opacity-80 transition-opacity\">Roh-zu-Gekocht-Rechner</a>, um gekochte Portionen exakt in Rohwerte umzurechnen."
      }
    }
  ]
};
---

<Layout title={seo.title} description={seo.description} keywords={seo.keywords}>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION -->
  <section class="relative pt-12 pb-10 sm:pt-16 sm:pb-14 border-b border-hairline overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 text-center flex flex-col items-center">
      
      <!-- Telemetry Badge -->
      <div class="inline-flex items-center justify-center gap-2 px-3 py-1 rounded-full border border-hairline bg-canvas-elevated text-[11px] sm:text-xs font-medium text-mute mb-6 max-w-full text-center" style="font-family: var(--font-mono);">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-grad-cyan)] animate-pulse flex-shrink-0"></span>
        <span class="truncate sm:whitespace-normal">Klinische Präzision • Mifflin-St Jeor & Katch-McArdle • Edition 2026</span>
      </div>

      <!-- Main H1 Heading -->
      <h1 class="text-3xl xs:text-4xl sm:text-5xl lg:text-6xl font-extrabold text-ink tracking-tight max-w-4xl leading-[1.1] text-balance break-words">
        Kostenloser <span class="text-transparent bg-clip-text bg-gradient-to-r from-ink via-mute to-ink">Erhaltungskalorien</span> Rechner (TDEE)
      </h1>

      <!-- Supporting Subheading -->
      <p class="mt-5 text-base sm:text-lg text-mute max-w-2xl leading-relaxed text-balance">
        Ermitteln Sie Ihren exakten täglichen Kalorienbedarf (TDEE) und Grundumsatz (BMR) mit wissenschaftlich fundierten Formeln. Perfekt abgestimmt für Fettabbau, Muskelerhalt oder Hypertrophie.
      </p>

      <!-- Trust Badges -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4 text-xs text-mute" style="font-family: var(--font-mono);">
        <span class="flex items-center gap-1.5">✓ Mifflin-St Jeor Gleichung</span>
        <span class="flex items-center gap-1.5">✓ Katch-McArdle Formel</span>
        <span class="flex items-center gap-1.5">✓ Revidierte Harris-Benedict</span>
        <span class="flex items-center gap-1.5">✓ 100% Kostenlos & Ohne Anmeldung</span>
      </div>
    </div>
  </section>

  <!-- CALCULATOR SECTION -->
  <section id="calculator" class="py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <Calculator lang="de" />
    </div>
  </section>

  <!-- THE 4 PILLARS OF TDEE -->
  <section id="science" class="max-w-6xl mx-auto px-4 sm:px-6 py-20 border-t border-hairline">
    <div class="max-w-3xl mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-mute" style="font-family: var(--font-mono);">Stoffwechselphysiologie</span>
      <h2 class="text-3xl font-bold text-ink tracking-tight mt-1 mb-3">Die 4 Säulen Ihres täglichen Energiebedarfs (TDEE)</h2>
      <p class="text-body text-sm leading-relaxed">
        Ihr Organismus verbraucht Energie über vier voneinander abhängige physiologische Komponenten:
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- BMR Card -->
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-sm font-mono">01</span>
            <span class="text-xs font-bold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/50 px-2 py-0.5 rounded font-mono">60 - 70%</span>
          </div>
          <h3 class="text-base font-bold text-ink mb-1.5">Grundumsatz (BMR)</h3>
          <p class="text-xs text-body leading-relaxed">
            Lebensnotwendige Energie zur Aufrechterhaltung der Organfunktionen (Gehirn, Herz, Leber, Lunge und Nieren) im Ruhezustand.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hairline text-[11px] text-mute font-medium">
          Hauptfaktoren: Muskelmasse, Körpergröße, Alter und Geschlecht.
        </div>
      </div>

      <!-- NEAT Card -->
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-sm font-mono">02</span>
            <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 px-2 py-0.5 rounded font-mono">15 - 25%</span>
          </div>
          <h3 class="text-base font-bold text-ink mb-1.5">Alltagsbewegung (NEAT)</h3>
          <p class="text-xs text-body leading-relaxed">
            Verbrannte Kalorien durch spontane Alltagsaktivitäten: Gehen, Treppensteigen, Hausarbeit, Gestikulieren und Stehen.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hairline text-[11px] text-mute font-medium">
          Der wichtigste Hebel zur Steigerung des Kaloriendefizits.
        </div>
      </div>

      <!-- TEF Card -->
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="w-8 h-8 rounded-lg bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-sm font-mono">03</span>
            <span class="text-xs font-bold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/50 px-2 py-0.5 rounded font-mono">8 - 12%</span>
          </div>
          <h3 class="text-base font-bold text-ink mb-1.5">Thermischer Effekt (TEF)</h3>
          <p class="text-xs text-body leading-relaxed">
            Energieaufwand zur Spaltung, Verdauung und Verwertung von Makronährstoffen. Eiweiß benötigt 20% bis 30% seiner Eigenkalorien.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hairline text-[11px] text-mute font-medium">
          Wird durch eine proteinreiche Ernährung spürbar maximiert.
        </div>
      </div>

      <!-- EAT Card -->
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="w-8 h-8 rounded-lg bg-purple-50 dark:bg-purple-950/50 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-sm font-mono">04</span>
            <span class="text-xs font-bold text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-950/50 px-2 py-0.5 rounded font-mono">5 - 15%</span>
          </div>
          <h3 class="text-base font-bold text-ink mb-1.5">Sportliches Training (EAT)</h3>
          <p class="text-xs text-body leading-relaxed">
            Gezielte körperliche Belastung: Hypertrophietraining im Fitnessstudio, Laufen, Intervalltraining und Mannschaftssport.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hairline text-[11px] text-mute font-medium">
          Entscheidend für den Muskelerhalt während einer Diät.
        </div>
      </div>
    </div>
  </section>

  <!-- FORMULA COMPARISON TABLE -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16 border-t border-hairline">
    <div class="max-w-3xl mb-8">
      <span class="text-xs font-semibold uppercase tracking-wider text-mute" style="font-family: var(--font-mono);">Methodenvergleich</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight mt-1 mb-2">Vergleich klinisch validierter Formeln</h2>
      <p class="text-body text-sm leading-relaxed">
        Wechseln Sie zwischen den drei in der Sport- und Ernährungswissenschaft am häufigsten zitierten Rechenmodellen:
      </p>
    </div>

    <div class="overflow-x-auto bg-canvas-elevated rounded-2xl border border-hairline shadow-xs max-w-full overscroll-x-contain">
      <table class="w-full min-w-[550px] text-left text-xs sm:text-sm">
        <thead class="bg-canvas border-b border-hairline font-semibold text-ink uppercase tracking-wider text-[11px]" style="font-family: var(--font-mono);">
          <tr>
            <th class="py-3.5 px-4 sm:px-6">Formel</th>
            <th class="py-3.5 px-4 sm:px-6">Schlüsselvariablen</th>
            <th class="py-3.5 px-4 sm:px-6">Wesentlicher Vorteil</th>
            <th class="py-3.5 px-4 sm:px-6">Empfohlen für</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-body">
          <tr class="hover:bg-canvas/50 transition-colors">
            <td class="py-4 px-4 sm:px-6 font-bold text-ink">Mifflin-St Jeor (1990)</td>
            <td class="py-4 px-4 sm:px-6">Gewicht, Größe, Alter, Geschlecht</td>
            <td class="py-4 px-4 sm:px-6">Höchste empirische Genauigkeit ohne apparative Körperfettmessung.</td>
            <td class="py-4 px-4 sm:px-6"><span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 font-medium">Allgemeine Bevölkerung</span></td>
          </tr>
          <tr class="hover:bg-canvas/50 transition-colors">
            <td class="py-4 px-4 sm:px-6 font-bold text-ink">Katch-McArdle (1996)</td>
            <td class="py-4 px-4 sm:px-6">Magermasse (LBM) via KFA%</td>
            <td class="py-4 px-4 sm:px-6">Berechnet den tatsächlichen Energieverbrauch der stoffwechselaktiven Muskelmasse.</td>
            <td class="py-4 px-4 sm:px-6"><span class="px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-400 font-medium">Athleten & Kraftsportler</span></td>
          </tr>
          <tr class="hover:bg-canvas/50 transition-colors">
            <td class="py-4 px-4 sm:px-6 font-bold text-ink">Revidierte Harris-Benedict (1984)</td>
            <td class="py-4 px-4 sm:px-6">Gewicht, Größe, Alter, Geschlecht</td>
            <td class="py-4 px-4 sm:px-6">Klinischer Klassiker, 1984 von Roza & Shizgal neu normiert.</td>
            <td class="py-4 px-4 sm:px-6"><span class="px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/50 text-purple-700 dark:text-purple-400 font-medium">Klinische Referenz</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- MACRO GUIDE SECTION -->
  <section id="macros" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 border-t border-hairline">
    <div class="max-w-3xl mb-10">
      <span class="text-xs font-semibold uppercase tracking-wider text-mute" style="font-family: var(--font-mono);">Optimale Ernährung</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight mt-1 mb-2">Makronährstoff-Verteilung für Ihre Ziele</h2>
      <p class="text-body text-sm leading-relaxed">
        Die Gesamtkalorien bestimmen Gewichtsverlust oder -zunahme. Die Verteilung der Makronährstoffe entscheidet, ob Fett oder Muskelgewebe abgebaut bzw. aufgebaut wird:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 shadow-xs flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[var(--color-grad-blue)]"></span>
          <h3 class="text-base font-bold text-ink">Proteine (4 kcal / Gramm)</h3>
        </div>
        <p class="text-xs text-body leading-relaxed">
          Grundbaustein für Proteinsynthese, Zellerneuerung und Muskelerhalt. Besitzt die höchste Sättigungswirkung und schützt im Kaloriendefizit vor Muskelabbau.
        </p>
        <div class="mt-auto bg-canvas p-3 rounded-xl border border-hairline text-xs font-medium text-ink">
          <strong>Optimaler Richtwert:</strong> 1,6 bis 2,2 g pro kg Körpergewicht.
        </div>
      </div>

      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 shadow-xs flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[var(--color-grad-magenta)]"></span>
          <h3 class="text-base font-bold text-ink">Fette (9 kcal / Gramm)</h3>
        </div>
        <p class="text-xs text-body leading-relaxed">
          Unerlässlich für die Synthese lebenswichtiger Hormone (Testosteron, Östrogene) sowie die Resorption fettlöslicher Vitamine (A, D, E, K).
        </p>
        <div class="mt-auto bg-canvas p-3 rounded-xl border border-hairline text-xs font-medium text-ink">
          <strong>Optimaler Richtwert:</strong> 20% bis 30% der Gesamtkalorien (mind. 0,7g/kg).
        </div>
      </div>

      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 shadow-xs flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[var(--color-grad-amber)]"></span>
          <h3 class="text-base font-bold text-ink">Kohlenhydrate (4 kcal / Gramm)</h3>
        </div>
        <p class="text-xs text-body leading-relaxed">
          Primäre Energiequelle für das zentrale Nervensystem und anaerobe Trainingsbelastungen. Füllen die Glykogenspeicher in Leber und Muskulatur auf.
        </p>
        <div class="mt-auto bg-canvas p-3 rounded-xl border border-hairline text-xs font-medium text-ink">
          <strong>Optimaler Richtwert:</strong> Entspricht den verbleibenden Kalorien.
        </div>
      </div>
    </div>
  </section>

  <!-- FAQS SECTION -->
  <section id="faq" class="max-w-4xl mx-auto px-4 sm:px-6 py-20 border-t border-hairline">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-mute" style="font-family: var(--font-mono);">Fragen & Antworten</span>
      <h2 class="text-3xl font-bold text-ink tracking-tight mt-1 mb-2">Häufig gestellte Fragen zu Erhaltungskalorien</h2>
      <p class="text-body text-sm leading-relaxed">
        Wissenschaftlich fundierte Antworten zu Kalorienbedarf, Fettabbau-Defiziten und Stoffwechselregulation.
      </p>
    </div>

    <div class="flex flex-col gap-3.5">
      {faqSchema.mainEntity.map((item) => (
        <details class="group bg-canvas-elevated border border-hairline rounded-xl p-5 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer items-center justify-between font-semibold text-ink text-sm sm:text-base">
            <span>{item.name}</span>
            <span class="transition group-open:rotate-180 text-mute">
              <svg fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-body mt-3 text-xs sm:text-sm leading-relaxed" set:html={item.acceptedAnswer.text} />
        </details>
      ))}
    </div>
  </section>
</Layout>
