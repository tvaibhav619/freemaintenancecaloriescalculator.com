---
import Layout from '../../layouts/Layout.astro';

const title = "お問い合わせ・サポート | FreeMaintenanceCaloriesCalculator.com";
const description = "計算式の詳細、不具合の報告、機能の提案など、FreeMaintenanceCaloriesCalculator.comへのお問い合わせはこちらから。";
---

<Layout title={title} description={description}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <div class="border-b border-hairline pb-8 mb-10 text-center">
      <span class="text-xs font-semibold uppercase tracking-wider text-mute" style="font-family: var(--font-mono);">お問い合わせ</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight mt-1 mb-2">お問い合わせ・サポート</h1>
      <p class="text-sm text-body max-w-md mx-auto mb-4">
        計算式に関するご質問、表示の不具合、機能追加のご要望など、お気軽にお問い合わせください。
      </p>
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-canvas-elevated border border-hairline text-xs text-mute">
        <span>公式メールアドレス:</span>
        <a href="mailto:hello@freemaintenancecaloriecalculator.com" class="font-semibold text-ink hover:underline">hello@freemaintenancecaloriecalculator.com</a>
      </div>
    </div>

    <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 sm:p-8 shadow-xs">
      <form id="contact-form" class="flex flex-col gap-5">
        <div>
          <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-ink mb-1.5" style="font-family: var(--font-mono);">お名前</label>
          <input type="text" id="name" name="name" required placeholder="山田 太郎" class="w-full bg-canvas text-ink border border-hairline rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all" />
        </div>

        <div>
          <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-ink mb-1.5" style="font-family: var(--font-mono);">メールアドレス</label>
          <input type="email" id="email" name="email" required placeholder="example@domain.jp" class="w-full bg-canvas text-ink border border-hairline rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all" />
        </div>

        <div>
          <label for="subject" class="block text-xs font-semibold uppercase tracking-wider text-ink mb-1.5" style="font-family: var(--font-mono);">お問い合わせ件名</label>
          <select id="subject" name="subject" class="w-full bg-canvas text-ink border border-hairline rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all">
            <option value="feedback">一般的なご意見・ご要望</option>
            <option value="bug">不具合・計算結果の相違報告</option>
            <option value="formula">科学的計算式に関するお問い合わせ</option>
            <option value="business">ビジネス・メディア関連</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-ink mb-1.5" style="font-family: var(--font-mono);">メッセージ内容</label>
          <textarea id="message" name="message" rows="5" required placeholder="お問い合わせ内容をご入力ください..." class="w-full bg-canvas text-ink border border-hairline rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all"></textarea>
        </div>

        <button type="submit" id="submit-btn" class="bg-primary text-on-primary hover:bg-black font-semibold text-sm py-3 px-6 rounded-xl transition-all shadow-xs self-start">
          メッセージを送信
        </button>
        <p id="form-status" class="text-xs text-emerald-600 font-medium hidden">ありがとうございます。メッセージは正常に送信されました。</p>
      </form>
    </div>

    <script>
      const form = document.getElementById("contact-form") as HTMLFormElement;
      const status = document.getElementById("form-status") as HTMLElement;
      const btn = document.getElementById("submit-btn") as HTMLButtonElement;

      form?.addEventListener("submit", (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.innerText = "送信中...";
        setTimeout(() => {
          form.reset();
          btn.disabled = false;
          btn.innerText = "メッセージを送信";
          status.classList.remove("hidden");
          setTimeout(() => status.classList.add("hidden"), 5000);
        }, 600);
      });
    </script>
  </div>
</Layout>
